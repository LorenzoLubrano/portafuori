<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Android 9-11: encrypted cloud backup or device-to-device transfer only (flags are AND-ed, so one include each) -->
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="datastore/" requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/" requireFlags="deviceToDeviceTransfer" />
    <!-- the synchronous copy of theme and style, so the first start after a restore is already in the right style -->
    <include domain="sharedpref" path="ui.xml" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="ui.xml" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
